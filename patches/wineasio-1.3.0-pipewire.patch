+/* Delivers the notifications queued by the JACK callbacks from a Wine thread. */
+static DWORD WINAPI notify_thread_proc(LPVOID arg)
+{
+    IWineASIOImpl   *This = (IWineASIOImpl*)arg;
+    LONG            pending;
+
+    while (!This->notify_thread_stop)
+    {
+        Sleep(10);
+        pending = InterlockedExchange(&This->pending_notifications, 0);
+        if (!pending || This->host_driver_state != Running || !This->host_callbacks)
+            continue;
+
+        if (pending & NotifySampleRate)
+        {
+            This->host_sample_rate = InterlockedCompareExchange(&This->pending_sample_rate, 0, 0);
+            This->host_callbacks->sampleRateChanged(This->host_sample_rate);
+        }
+        if ((pending & NotifyBufferSize) && This->host_callbacks->sendNotification(1, 3, 0, 0))
+            This->host_callbacks->sendNotification(3, 0, 0, 0);
+        /* PipeWire recomputes latencies on every graph change (any link, any other client);
+         * hosts such as Serato restart the driver on kAsioLatenciesChanged, so only report real changes. */
+        if ((pending & NotifyLatency) && update_reported_latencies(This)
+                && This->host_callbacks->sendNotification(1, 6, 0, 0))
+            This->host_callbacks->sendNotification(6, 0, 0, 0);
+    }
     return 0;
 }
 
+/* Returns TRUE when the latencies differ from the ones last reported to the host. */
+static BOOL update_reported_latencies(IWineASIOImpl *This)
+{
+    jack_latency_range_t    in_range, out_range;
+    BOOL                    changed;
+
+    jackbridge_port_get_latency_range(This->input_channel[0].port, JackCaptureLatency, &in_range);
+    jackbridge_port_get_latency_range(This->output_channel[0].port, JackPlaybackLatency, &out_range);
+    changed = in_range.max != This->reported_input_latency || out_range.max != This->reported_output_latency;
+    This->reported_input_latency = in_range.max;
+    This->reported_output_latency = out_range.max;
+    return changed;
+}
+
+static void stop_notify_thread(IWineASIOImpl *This)
+{
+    if (!This->notify_thread)
+        return;
+    InterlockedExchange(&This->notify_thread_stop, 1);
+    /* The host may release the driver from inside one of its own notification handlers. */
+    if (GetCurrentThreadId() != GetThreadId(This->notify_thread))
+        WaitForSingleObject(This->notify_thread, INFINITE);
+    CloseHandle(This->notify_thread);
+    This->notify_thread = NULL;
+}
